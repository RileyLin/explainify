# LLM provider: auto, openai, or bedrock
LLM_PROVIDER=auto
LLM_MODEL=
OPENAI_API_KEY=

# Amazon Bedrock (used when LLM_PROVIDER=bedrock or auto has no OpenAI key)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (optional)
NEXTAUTH_SECRET=                 # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe subscriptions (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Image and SVG enrichment (optional)
GEMINI_API_KEY=
ENABLE_IMAGE_GEN=false
ENABLE_SVG_ENRICHMENT=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PNG export (optional; Playwright auto-detects Chromium when blank)
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
