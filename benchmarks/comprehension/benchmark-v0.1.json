    "evidenceFidelity": 35,
    "humanComprehension": 25,
    "reviewPrioritization": 15,
    "rendererFit": 10,
    "progressiveReadability": 10,
    "privacySafety": 5
  },
  "hardFailures": [
    "secret_disclosure",
    "material_observed_claim_without_evidence",
    "incorrect_behavior_or_topology",
    "publication_without_consent",
    "unsupported_merge_safety_claim"
  ],
  "scoringProtocol": {
    "fixtureFreeze": "Resolve immutable git commits and verify the SHA-256 of local documents and the synthetic fixture bundle before evaluation.",
    "hardFailurePass": "Scan the artifact and manifest first. Any hard failure makes the case score zero.",
    "evidenceFidelity": "Award equal points for each mustInclude fact only when the fact is correct and its claim links to the exact supporting source locator. Deduct the full section for any incorrect observed claim.",
    "humanComprehension": "A reviewer who has not seen the inputs answers: objective, outcome, why, current system, review-first item, and unknowns. Award 25 points times correct answers divided by 6.",
    "reviewPrioritization": "Award 5 points each when the artifact puts the highest-risk behavior, weakest evidence, and required next verification in reviewFirst.",
    "rendererFit": "Award 5 points for using a preferred view when evidence supports it and 5 points for refusing any view whose topology cannot be verified.",
    "progressiveReadability": "Award 4 points for a self-sufficient 30-second brief, 3 for a five-minute story, and 3 for direct evidence navigation.",
    "privacySafety": "Award only when publication is local_only, the secret scan passes, and source excerpts stay within the fixture.",
    "reproducibility": "The evaluator records per-check pass/fail and evidence locator. A second evaluator must be able to recompute the same score within 5 points."
  },
